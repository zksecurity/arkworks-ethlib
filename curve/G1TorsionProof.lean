import GLVGroupProof
import FiniteCurveProof
import PrimeTorsionProof
import ScalarPrimeProof

open EthLib.Cryptography.Bls

namespace G1Torsion
noncomputable section
local instance : Field Fp := G1Curve.fieldStructure
local instance : CommRing Fp := G1Curve.fieldStructure.toCommRing

abbrev Point := G1Curve.curve.toAffine.Point

/-- The coarse x-fiber bound is already far below r² for BLS12-381. -/
theorem point_card_bound : Nat.card Point ≤ 3 * Fp.modulus := by
  simpa only [Fintype.card_fin] using FiniteCurve.card_le_three_mul G1Curve.curve

theorem point_card_lt_order_sq : Nat.card Point < Fr.modulus * Fr.modulus := by
  have hn : 3 * Fp.modulus < Fr.modulus * Fr.modulus := by decide +kernel
  exact point_card_bound.trans_lt hn

theorem generator_onCurve : G1Curve.OnCurve G1.generator := by
  apply (G1Curve.onCurve_iff G1.generator).mp
  decide +kernel

theorem generator_nonzero : G1Curve.interpret G1.generator ≠ 0 :=
  G1Curve.interpret_nonzero G1.generator generator_onCurve (by decide +kernel)

theorem generator_inSubgroup : G1.inSubgroup G1.generator = true := by decide +kernel

theorem generator_killed : Fr.modulus • G1Curve.interpret G1.generator = 0 :=
  (G1Curve.inSubgroup_iff G1.generator generator_onCurve).mp generator_inSubgroup

theorem generator_order : addOrderOf (G1Curve.interpret G1.generator) = Fr.modulus := by
  have hd := addOrderOf_dvd_iff_nsmul_eq_zero.mpr generator_killed
  rcases (Nat.dvd_prime ScalarPrime.modulus_prime).mp hd with h | h
  · exact (generator_nonzero (AddMonoid.addOrderOf_eq_one_iff.mp h)).elim
  · exact h

/-- All mathematical r-torsion is generated by the standard G1 generator. -/
theorem torsion_mem_generator (p : Point) (hp : Fr.modulus • p = 0) :
    p ∈ AddSubgroup.zmultiples (G1Curve.interpret G1.generator) := by
  let : Finite Point := FiniteCurve.finite_points G1Curve.curve
  exact PrimeTorsion.mem_zmultiples_of_card_lt_sq Fr.modulus ScalarPrime.modulus_prime
    (G1Curve.interpret G1.generator) generator_order point_card_lt_order_sq p hp

/-- Kernel-checked fixed-base action identifies which primitive cube root is used. -/
theorem generator_eigenvalue : G1Curve.interpret (G1Endomorphism.map G1.generator) =
    GLVDecomposition.eigenvalue • G1Curve.interpret G1.generator := by
  let n := GLVDecomposition.eigenvalue.toNat
  have he : (n : Int) = GLVDecomposition.eigenvalue := by decide +kernel
  calc
    _ = G1Curve.interpret (G1.mulNat G1.generator n) := by
      apply G1Curve.interpret_eq_of_XY
      · decide +kernel
      · decide +kernel
      · unfold G1Curve.XEq
        decide +kernel
      · unfold G1Curve.YEq
        decide +kernel
    _ = n • G1Curve.interpret G1.generator := (G1Curve.mulNat_correct G1.generator n generator_onCurve).2
    _ = GLVDecomposition.eigenvalue • G1Curve.interpret G1.generator := by
      rw [← he, natCast_zsmul]

#print axioms point_card_bound
#print axioms point_card_lt_order_sq
#print axioms generator_onCurve
#print axioms generator_nonzero
#print axioms generator_inSubgroup
#print axioms generator_killed
#print axioms generator_order
#print axioms torsion_mem_generator
#print axioms generator_eigenvalue
end
end G1Torsion
